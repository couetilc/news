---
import type { ItemRow } from '../ingest/db';
import { PAGE_SIZE, encodeCursor, itemCursor, type Tab } from '../lib/pagination';
import Article from './Article.astro';

interface Props {
	// Fetch PAGE_SIZE + 1 rows; the lookahead determines exhaustion without a
	// separate count snapshot. Only the first PAGE_SIZE rows are rendered.
	items: ItemRow[];
	tab: Tab;
	sources: string[];
	returnTo: string;
}
const { items, tab, sources, returnTo } = Astro.props;
const visible = items.slice(0, PAGE_SIZE);
const more = items.length > PAGE_SIZE;
function nextUrl(): string {
	const params = new URLSearchParams({ tab });
	for (const source of sources) params.append('source', source);
	params.set('cursor', encodeCursor(itemCursor(visible[visible.length - 1])));
	return `/feed?${params}`;
}

---

{visible.map((item) => <Article item={item} returnTo={returnTo} />)}
{
	more && (
		<li
			data-feed-sentinel
			data-next-url={nextUrl()}
			class="border-b border-rule py-3 text-center font-sans text-[0.6rem] italic uppercase tracking-wider text-muted"
		>
			Loading more…
		</li>
	)
}
