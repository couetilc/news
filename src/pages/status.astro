---
import Layout from '../layouts/Layout.astro';
import { deployInfo } from '../lib/deploy';
import {env} from 'cloudflare:workers';
import {getHealthRows, getRecentRuns} from '../ingest/health-db';
import {SOURCES} from '../ingest/sources';
import {healthViews, healthTime, runVerdict} from '../lib/feed-health';

// Public build metadata plus owner-only live operational state.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Vary', 'Cookie');
const owner = Astro.locals.userId !== undefined;
const rowsHealth = owner ? await getHealthRows(env.NEWS_DB) : [];
const runs = owner ? await getRecentRuns(env.NEWS_DB) : [];
const now = Math.floor(Date.now() / 1000);
const health = healthViews(SOURCES, rowsHealth, now);
const heartbeat = runVerdict(runs[0], now);
const deploy = deployInfo();

// Each row of the colophon: a small-caps label and its value. Kept as data so
// the markup stays a single branch-free loop.
const rows = [
	{ label: 'Commit', value: deploy.shortSha, href: deploy.commitUrl, full: deploy.sha },
	{ label: 'Ref', value: deploy.ref },
	{ label: 'Deployed', value: deploy.timeLabel, time: deploy.time },
];
---

<Layout title="Status · News">
	<div class="mx-auto max-w-2xl">
		<a href="/" class="mb-4 inline-block font-sans text-xs underline underline-offset-2 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">← Back to feed</a>
		<h2
			class="mb-1 flex items-center gap-3 font-sans text-[0.65rem] uppercase tracking-[0.3em] text-muted"
		>
			<span class="h-px flex-1 bg-rule" aria-hidden="true"></span>
			Status
			<span class="h-px flex-1 bg-rule" aria-hidden="true"></span>
		</h2>
		<p class="mb-4 text-center font-sans text-xs text-muted">
			What is running in production right now.
		</p>

		<details open={!owner} class="border-y border-rule py-3">
			<summary class="cursor-pointer font-sans text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">Deployment</summary>
		<dl class="mt-2 border-t border-rule">
			{
				rows.map((r) => (
					<div class="flex items-baseline justify-between gap-4 border-b border-rule py-2.5">
						<dt class="font-sans text-[0.65rem] uppercase tracking-wider text-muted">
							{r.label}
						</dt>
						<dd class="min-w-0 text-right">
							{r.href ? (
								<a
									href={r.href}
									title={r.full}
									class="font-mono text-sm text-ink underline decoration-from-font underline-offset-2 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
								>
									{r.value}
								</a>
							) : r.time ? (
								<time
									datetime={r.time}
									class="font-mono text-sm text-ink"
								>
									{r.value}
								</time>
							) : (
								<span class="font-mono text-sm text-ink">{r.value}</span>
							)}
						</dd>
					</div>
				))
			}
		</dl>
		</details>

		{owner && (
			<section aria-label="Ingestion health" data-ingestion-health class="mt-8">
				<h2 class="text-2xl">Feed health</h2>
				<p class="mt-1 font-sans text-sm">{health.active.length} active feeds · {health.attention} need attention</p>
				<p class="mt-1 mb-4 font-sans text-xs text-muted">As of {healthTime(now)}. Refresh for the latest checks.</p>
				<div class:list={['mb-6 border-l-2 bg-paper-edge p-3', heartbeat.attention ? 'border-accent' : 'border-rule']}>
					<h3 class="font-sans text-sm font-semibold">{heartbeat.label}</h3>
					<p class="mt-1 font-sans text-xs">{heartbeat.note}</p>
					{runs.length > 0 && <dl class="mt-2 font-sans text-xs">
						<dt class="text-muted">Latest run started</dt><dd>{healthTime(runs[0].started_at)}</dd>
						<dt class="mt-1 text-muted">Latest run finished</dt><dd>{healthTime(runs[0].finished_at)}</dd>
						<dt class="mt-1 text-muted">Feeds checked in that run</dt><dd>{runs[0].polled}</dd>
						{runs[0].error && <><dt class="mt-1 text-muted">Batch error</dt><dd class="break-words">{runs[0].error}</dd></>}
					</dl>}
				</div>
				<p class="mb-3 font-sans text-xs text-muted">Checks run every 15 minutes; each feed keeps its own polling interval. A quiet publisher can be healthy. Item freshness is shared by all endpoints belonging to the same source.</p>
				{health.active.map((view) => <details open={view.verdict.attention && view.verdict.key !== 'never'} class="border-t border-rule py-3" data-feed-health={view.state.source}>
					<summary class="cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">
						<span class="font-semibold">{view.name}</span>
						<span class:list={['ml-2 font-sans text-xs', view.verdict.attention ? 'text-accent' : 'text-muted']}>{view.verdict.label}</span>
					</summary>
					<p class="mt-2 font-sans text-xs">{view.verdict.note}</p>
					<a href={view.state.feed} class="mt-1 block break-all font-sans text-xs text-muted underline underline-offset-2 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">{view.state.feed}</a>
					{view.state.last_error && <p class="mt-3 break-words font-sans text-xs"><strong>Latest error ({healthTime(view.state.last_error_at)}):</strong> {view.state.last_error}<br />{view.state.error_resolved_at === null ? 'Unresolved' : `Resolved ${healthTime(view.state.error_resolved_at)}`}</p>}
					{view.state.last_anomaly && <details class="mt-3"><summary class="cursor-pointer font-sans text-xs underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">Parsing anomaly details</summary><p class="mt-2 break-words font-sans text-xs"><strong>Latest parsing anomaly ({healthTime(view.state.last_anomaly_at)}):</strong> {view.state.last_anomaly}<br />{view.state.anomaly_resolved_at === null ? 'Unresolved' : `Resolved ${healthTime(view.state.anomaly_resolved_at)}`}</p></details>}
					<dl class="mt-3 grid grid-cols-2 gap-x-3 gap-y-2 font-sans text-xs">
						{[
							['Last attempt',healthTime(view.state.last_attempt_at)],
							['Attempt finished',healthTime(view.state.last_finished_at)],
							['Latest HTTP response',view.state.response_status ?? 'No response recorded'],
							['Last successful check',healthTime(view.state.last_success_at)],
							['Last clean parse',healthTime(view.state.last_clean_at)],
							['Next check due',view.state.next_poll_at === 0 ? 'Next scheduled run' : healthTime(view.state.next_poll_at)],
							['Newest saved item',healthTime(view.state.last_saved_at)],
							['Newest publication',healthTime(view.state.last_published_at)],
							['Items saved for source',view.state.item_count],
						].map(([label,value])=><><dt class="text-muted">{label}</dt><dd class="break-words">{value}</dd></>)}
					</dl>
				</details>)}
				<details class="mt-4 border-y border-rule py-3"><summary class="cursor-pointer font-sans text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">Retired endpoints ({health.retired.length})</summary>
					<p class="mt-2 font-sans text-xs text-muted">These stored endpoints are no longer polled and do not create overdue warnings.</p>
					<ul>{health.retired.map(view=><li class="mt-2 break-all font-sans text-xs">{view.name} — {view.state.feed}</li>)}</ul>
				</details>
				<details class="mt-4 border-b border-rule pb-3"><summary class="cursor-pointer font-sans text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">Recent scheduled runs</summary>
					<ul>{runs.map(run=><li class="mt-2 font-sans text-xs">Started {healthTime(run.started_at)} · Finished {healthTime(run.finished_at)} · {run.polled} checked · {run.failed_feeds} failures · {run.anomalous_feeds} anomalies</li>)}</ul>
				</details>
				<a href={deploy.observabilityUrl} class="mt-3 inline-block font-sans text-xs underline underline-offset-2 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">Open detailed production logs →</a>
			</section>
		)}
	</div>
</Layout>
