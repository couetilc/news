---
import { env } from 'cloudflare:workers';
import { distinctSources, listItemsByRead } from '../ingest/db';
import FeedPage from '../components/FeedPage.astro';
import { activeSourceFilter, feedReturnTo } from '../lib/digest';
import { PAGE_SIZE, isReadTab, parseCursor, parseTab } from '../lib/pagination';

// Authenticated HTML partial; the middleware supplies the owner identity.
// Reuses the same Article markup as the initial SSR page.
const userId = Astro.locals.userId;

// The middleware sets locals.userId for every request that reaches an unguarded
// route like this; a request without it was already redirected to /login. The
// `?? 0` is a typed fallback that can't match a real user and is never reached in
// practice, mirroring /api/read.
const queryUser = userId ?? 0;

const tab = parseTab(Astro.url.searchParams.get('tab'));
const cursor = parseCursor(Astro.url.searchParams.get('cursor'));
if (cursor === null || Astro.url.searchParams.has('offset')) {
	return new Response('Invalid feed cursor. Reload the feed.', { status: 400 });
}
const present = await distinctSources(env.NEWS_DB);
const sources = activeSourceFilter(Astro.url.searchParams.getAll('source'), present);

const read = isReadTab(tab);
const items = await listItemsByRead(env.NEWS_DB, {
	userId: queryUser,
	read,
	limit: PAGE_SIZE + 1,
	cursor,
	sources,
});

// A toggle in an appended row returns to the top of the active tab + source
// filter (feedReturnTo in digest.ts — the cursor is deliberately dropped, see
// safeReturnPath), so the reader lands back on the same tab/filter, not the
// unfiltered home (#80).
const returnTo = feedReturnTo(tab, sources);
---

<FeedPage
	items={items}
	tab={tab}
	sources={sources}
	returnTo={returnTo}
/>
