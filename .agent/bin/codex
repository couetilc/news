#!/bin/sh
# agentic-coding shim (engine-owned; regenerated by `agent init`, pins the major).
# With direnv active this shadows the host `codex`; escape hatch: `command codex`.
if [ "${IS_SANDBOX:-}" = "1" ]; then
	echo "codex: already inside the agent container; host shim skipped." >&2
	exit 0
fi
exec npx -y @couetilc/agentic-coding@^0 codex "$@"
