#!/bin/sh
# agentic-coding shim (engine-owned; regenerated by `agent init`, pins the major).
# Optional container launcher; invoke explicitly as ./.agent/bin/claude.
# Do not add this directory to PATH: `command claude` would still select this shim.
if [ "${IS_SANDBOX:-}" = "1" ]; then
	echo "claude: already inside the agent container; host shim skipped." >&2
	exit 0
fi
exec npx -y @couetilc/agentic-coding@^0 claude "$@"
