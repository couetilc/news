{
  "name": "news",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "test": "vitest run --coverage",
    "test:e2e": "node e2e/run.mjs",
    "test:mutation": "stryker run",
    "astro": "astro",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply NEWS_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply NEWS_DB --remote",
    "typecheck": "wrangler types .astro/worker-runtime.d.ts --include-env false && astro check --minimumSeverity warning && tsc -p tsconfig.worker.json && tsc -p tsconfig.browser.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.2.9",
    "fast-xml-parser": "^5.8.0",
    "htmlparser2": "12.0.0",
    "tailwindcss": "^4.3.1",
    "wrangler": "^4.131.1"
  },
  "overrides": {
    "vite": "^8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/vitest-pool-workers": "^0.16.15",
    "@playwright/test": "1.61.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "fast-check": "^4.8.0",
    "happy-dom": "^20.10.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
